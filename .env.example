# NOXI — COPY THIS FILE TO .env LOCALLY.
# NEVER put real secret values in this committed example file.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Generate each private secret separately:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-secret
OWNER_USERNAME=jash
OWNER_SETUP_TOKEN=replace-with-different-long-random-secret
NOXI_INTERNAL_API_SECRET=replace-with-another-long-random-secret

# Required hosted Postgres database (Supabase works)
DATABASE_URL=

# Optional password-reset email through Resend
RESEND_API_KEY=
EMAIL_FROM=

# Optional Supabase Storage uploads. SERVICE ROLE KEY IS SERVER-ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=noxi-uploads

# Optional Discord moderation bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
NOXI_INTERNAL_API_URL=http://127.0.0.1:3000

# Optional rewarded-ad provider. Keep disabled until a legitimate provider is configured.
REWARDED_ADS_ENABLED=false
REWARDED_AD_WEBHOOK_SECRET=

# Optional external donation page. Never store card data inside NOXI.
DONATIONS_ENABLED=false
DONATION_URL=
