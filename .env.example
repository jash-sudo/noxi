PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Generate each secret separately with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
OWNER_USERNAME=jash
OWNER_SETUP_TOKEN=replace-with-a-different-long-random-secret
NOXI_INTERNAL_API_SECRET=replace-with-another-long-random-secret

# Production hosted database. Keep this secret. Never put it in frontend JS.
DATABASE_URL=

# Discord bot (optional until you enable it)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
NOXI_INTERNAL_API_URL=http://127.0.0.1:3000

# Provider integrations stay disabled until you connect a provider that permits your account/age/region.
REWARDED_ADS_ENABLED=false
DONATIONS_ENABLED=false
